# texturepacks.art HTTP Basic Auth credentials.
#
# Releases are GitHub release assets now and need none of this. It is read
# only by scripts/bridge-legacy.sh, which moves the clients built before the
# switch (they poll texturepacks.art and nothing else) onto GitHub releases,
# and by anyone building a client with presence turned on:
#
#   go build -ldflags "-X main.presenceUser=$EQOA_UPDATE_USER -X main.presencePass=$EQOA_UPDATE_PASS" ./cmd/client
#
# Copy this file to `.deploy-secrets` (git-ignored), fill in the real values,
# then `source scripts/.deploy-secrets`. Never put these in a release build:
# a release is a public download, and anything in it is readable by anyone.

export EQOA_UPDATE_USER="eqoa"
export EQOA_UPDATE_PASS="CHANGE_ME"
