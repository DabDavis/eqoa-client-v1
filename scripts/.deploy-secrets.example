# Update-server HTTP Basic Auth credentials.
#
# Copy this file to `.deploy-secrets` (git-ignored) and fill in the real
# values, then `source scripts/.deploy-secrets` before running deploy.sh /
# deploy-dev.sh. The deploy scripts inject these into the client binary at
# build time via -ldflags, so they are never hardcoded in source.
#
#   cp scripts/.deploy-secrets.example scripts/.deploy-secrets
#   $EDITOR scripts/.deploy-secrets
#   source scripts/.deploy-secrets && ./scripts/deploy.sh
#
# NOTE: these creds still end up embedded (and strings-extractable) in the
# shipped binary — the client must authenticate to a public download endpoint,
# so this Basic Auth is only a soft gate, not a real secret. Rotate freely.

export EQOA_UPDATE_USER="eqoa"
export EQOA_UPDATE_PASS="CHANGE_ME"
